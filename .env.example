# BrainAPI: BRAIN_API_ENDPOINT may be a base URL or the full /api/v1/prediction URL.
BRAIN_API_ENDPOINT=
BRAIN_API_PROJECT_ID_DRIVE=
BRAIN_API_PROJECT_ID_MAIL=
BRAIN_API_KEY=

# Azure Storage. Leave empty locally to save under data/submissions.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=exam-data

# Admin URL: /admin/<ADMIN_PATH>
ADMIN_PATH=preview
ADMIN_PASSWORD=grade4-preview
